<AuMainHeader
  @brandLink="https://www.vlaanderen.be/nl"
  @homeRoute="home"
  @appTitle="Lokaal Beslist"
>
  <li class="au-c-list-horizontal__item">
    <AuLink @route="help" @skin="secondary" @icon="question-circle">
      Meer info
    </AuLink>
  </li>
  {{#if (not this.currentSession.isLoaded)}}{{else if
    this.currentSession.isLoggedIn
  }}
    <li class="au-c-list-horizontal__item c-app-header__user">
      <AuDropdown
        @title={{this.currentSession.userLabel}}
        @alignment="right"
        class="c-app-header__user-menu"
        role="menu"
        data-test-user-menu
      >
        <AuLink
          @route="validation-reports"
          @icon="circle-check"
          role="menuitem"
        >
          Bekijk validatierapport
        </AuLink>
        <AuButton
          @skin="link"
          @icon="logout"
          role="menuitem"
          {{on "click" this.logout}}
        >
          Afmelden
        </AuButton>
      </AuDropdown>
    </li>
  {{else if this.currentSession.isMockLogin}}
    <li class="au-c-list-horizontal__item">
      <AuLink @route="mock-login" @skin="secondary" @icon="login">
        Aanmelden (mock)
      </AuLink>
    </li>
  {{else if this.currentSession.isAcmidmConfigured}}
    <li class="au-c-list-horizontal__item">
      <AuButton @skin="link" @icon="login" {{on "click" this.login}}>
        Aanmelden
      </AuButton>
    </li>
  {{/if}}
</AuMainHeader>