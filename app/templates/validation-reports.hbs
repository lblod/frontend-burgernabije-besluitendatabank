{{page-title "Validatierapporten"}}
<AuBodyContainer>
  <div class="c-interface">
    <div id="content" class="c-interface__content">
      <AuToolbar @size="medium" as |Group|>
        <Group>
          <AuHeading @level="1" @skin="2">
            {{this.currentSession.userLabel}}
          </AuHeading>
          <AuPill @skin="border">{{this.maturityLevelLabel}}</AuPill>
        </Group>
        <Group>
          <AuPill @skin="border" @icon="clock">
            {{this.lastHarvestLabel}}
          </AuPill>
          <AuButton @skin="primary" @icon="download">
            Downloaden rapport
          </AuButton>
        </Group>
      </AuToolbar>
      <div
        id="report-overview-stat-cards"
        class="au-u-flex au-u-flex--spaced au-o-box"
      >
        <div
          class="au-u-1-1 au-u-flex au-u-flex--column au-u-flex--between au-u-padding au-u-padding-top-small border-radius au-u-background-gray-200"
        >
          <p class="au-u-h4">Gepubliceerde zittingen</p>
          <p class="au-u-h2 au-u-medium">550</p>
        </div>
        <div
          class="au-u-1-1 au-u-flex au-u-flex--column au-u-flex--between au-u-padding au-u-padding-top-small border-radius au-u-background-gray-200"
        >
          <p class="au-u-h4">Gepubliceerde agenda's</p>
          <p><span class="au-u-h2 au-u-medium">540</span>/550</p>
        </div>
        <div
          class="au-u-1-1 au-u-flex au-u-flex--column au-u-flex--between au-u-padding au-u-padding-top-small border-radius au-u-background-gray-200"
        >
          <p class="au-u-h4">Gepubliceerde besluitenlijsten</p>
          <p><span class="au-u-h2 au-u-medium">540</span>/550</p>
        </div>
        <div
          class="au-u-1-1 au-u-flex au-u-flex--column au-u-flex--between au-u-padding au-u-padding-top-small border-radius au-u-background-gray-200"
        >
          <p class="au-u-h4">Gepubliceerde notulen</p>
          <p><span class="au-u-h2 au-u-medium">540</span>/550</p>
        </div>
      </div>

      <AuList
        @divider={{true}}
        class="c-validation-reports"
        data-test-validation-reports
        as |Item|
      >
        {{#each @model as |report|}}
          <Item class="c-validation-report-item">
            <div>
              <AuLink
                @route="sessions.session"
                @model={{report.session.id}}
                class="au-u-medium"
              >
                {{report.session.governingBodyNameResolved}}
              </AuLink>
              <p class="au-u-muted">{{report.session.dateFormatted}}</p>
            </div>
            {{#if report.conforms}}
              <AuPill @skin="success" @icon="circle-check">Conform</AuPill>
            {{else}}
              <AuPill @skin="warning" @icon="alert-triangle">Niet conform</AuPill>
            {{/if}}
          </Item>
        {{/each}}
      </AuList>
    </div>
    <FilterSidebar @id="filtersidebar" @class="c-interface__sidebar">
      <div class="c-interface__sidebar-main">
        <h3 class="au-u-h4 au-u-medium">Filters</h3>
        {{#if this.canFilterByGovernment}}
          <Filters::SelectMultipleFilter
            @id="municipality"
            @label="Besturen"
            @options={{this.governmentList.options}}
            @selected={{this.selectedGovernments}}
            @updateSelected={{this.updateSelectedGovernments}}
            @noMatchesMessage="Geen besturen gevonden"
            @searchField="label"
            @queryParam="gemeentes+provincies"
            @placeholder="Alle besturen"
          />
        {{/if}}
        <Filters::SelectMultipleFilter
          @id="governing-body"
          @label="Bestuursorganen"
          @options={{this.governingBodyOptions}}
          @selected={{this.selectedGoverningBodies}}
          @updateSelected={{this.updateSelectedGoverningBodies}}
          @noMatchesMessage="Geen bestuursorganen gevonden"
          @searchField="label"
          @queryParam="bestuursorganen"
          @placeholder="Alle bestuursorganen"
        />
      </div>
    </FilterSidebar>
  </div>
</AuBodyContainer>