{{page-title "Validatierapporten"}}
<AuBodyContainer>
  <div class="c-interface">
    <div
      id="content"
      class="c-interface__content c-interface__content--table au-u-flex au-u-flex--column"
    >
      <AuToolbar @size="large" as |Group|>
        <Group class="au-u-flex au-u-flex--vertical-center">
          <AuHeading @level="1" @skin="2">
            {{this.currentSession.userLabel}}
          </AuHeading>
          <MaturityPill @level={{this.maturityLevel}} />
        </Group>
        <Group>
          <AuPill @skin="border" @icon="clock">
            {{this.lastHarvestLabel}}
          </AuPill>
          <AuButton @skin="primary" @icon="download">
            Downloaden rapport
          </AuButton>
        </Group>
      </AuToolbar>
      <div
        id="report-overview-stat-cards"
        class="au-u-flex au-u-flex--spaced au-o-box"
      >
        <div
          class="au-u-1-1 au-u-flex au-u-flex--column au-u-flex--between au-u-padding au-u-padding-top-small border-radius au-u-background-gray-200"
        >
          <p class="au-u-h4">Gepubliceerde zittingen</p>
          <p class="au-u-h2 au-u-medium">550</p>
        </div>
        <div
          class="au-u-1-1 au-u-flex au-u-flex--column au-u-flex--between au-u-padding au-u-padding-top-small border-radius au-u-background-gray-200"
        >
          <p class="au-u-h4">Gepubliceerde agenda's</p>
          <p><span class="au-u-h2 au-u-medium">540</span>/550</p>
        </div>
        <div
          class="au-u-1-1 au-u-flex au-u-flex--column au-u-flex--between au-u-padding au-u-padding-top-small border-radius au-u-background-gray-200"
        >
          <p class="au-u-h4">Gepubliceerde besluitenlijsten</p>
          <p><span class="au-u-h2 au-u-medium">540</span>/550</p>
        </div>
        <div
          class="au-u-1-1 au-u-flex au-u-flex--column au-u-flex--between au-u-padding au-u-padding-top-small border-radius au-u-background-gray-200"
        >
          <p class="au-u-h4">Gepubliceerde notulen</p>
          <p><span class="au-u-h2 au-u-medium">540</span>/550</p>
        </div>
      </div>

      <div class="c-interface__table">
        <AuDataTable
          @content={{@model}}
          @page={{this.page}}
          @size={{this.itemsPerPage}}
          @noDataMessage="Er werden geen resultaten gevonden"
          @sort={{this.sort}}
          @hidePagination={{this.hidePagination}}
          as |t|
        >
          <t.content as |c|>
            <c.header>
              <AuDataTableThSortable
                @field="session.planned-start"
                @currentSorting={{this.sort}}
                @label="Zitting"
                @class="au-c-data-table__header-title"
              />
              <AuDataTableThSortable
                @field="session.governing-body-abstract.classification.label"
                @currentSorting={{this.sort}}
                @label="Bestuursorgaan"
                @class="au-c-data-table__header-title"
              />
              <AuDataTableThSortable
                @field="maturity-level"
                @currentSorting={{this.sort}}
                @label="Maturiteitsniveau"
                @class="au-c-data-table__header-title"
              />
              <AuDataTableThSortable
                @field="conforms"
                @currentSorting={{this.sort}}
                @label="Zijn alle documenten gepubliceerd?"
                @class="au-c-data-table__header-title"
              />
              <th>
                {{! Actions }}
              </th>
            </c.header>
            <c.body as |report|>
              <td>{{report.session.sessionTitle}}</td>
              <td>
                {{report.session.classification}}
                {{report.session.administrativeUnitName}}
              </td>
              <td>
                <MaturityPill @level={{report.maturityLevel}} />
              </td>
              <td>
                {{#if report.conforms}}
                  Ja
                {{else}}
                  Nee
                {{/if}}
              </td>
              <td>
                <AuLink
                  @route="sessions.session"
                  @model={{report.session.id}}
                  @icon="eye"
                >
                  {{#if report.conforms}}
                    Bekijk details
                  {{else}}
                    Los fouten op
                  {{/if}}
                </AuLink>
              </td>
            </c.body>
          </t.content>
        </AuDataTable>
      </div>
    </div>
    <FilterSidebar @id="filtersidebar" @class="c-interface__sidebar">
      <div class="c-interface__sidebar-main">
        <h3 class="au-u-h4 au-u-medium">Filters</h3>
        {{#if this.canFilterByGovernment}}
          <Filters::SelectMultipleFilter
            @id="municipality"
            @label="Besturen"
            @options={{this.governmentList.options}}
            @selected={{this.selectedGovernments}}
            @updateSelected={{this.updateSelectedGovernments}}
            @noMatchesMessage="Geen besturen gevonden"
            @searchField="label"
            @queryParam="gemeentes+provincies"
            @placeholder="Alle besturen"
          />
        {{/if}}
        <Filters::SelectMultipleFilter
          @id="governing-body"
          @label="Bestuursorganen"
          @options={{this.governingBodyOptions}}
          @selected={{this.selectedGoverningBodies}}
          @updateSelected={{this.updateSelectedGoverningBodies}}
          @noMatchesMessage="Geen bestuursorganen gevonden"
          @searchField="label"
          @queryParam="bestuursorganen"
          @placeholder="Alle bestuursorganen"
        />
        {{#if this.canFilterByGovernment}}
          <AuCheckbox
            @checked={{this.latestSessionPerMunicipality}}
            @onChange={{this.toggleLatestSessionPerMunicipality}}
            @disabled={{true}}
          >
            Toon recentste zitting per gemeente
          </AuCheckbox>
        {{/if}}
        <AuButton
          @skin="naked"
          @icon="cross"
          class="au-u-flex-self-end"
          {{on "click" this.resetFilters}}
        >
          Herstel alle filters
        </AuButton>
      </div>
    </FilterSidebar>
  </div>
</AuBodyContainer>